# ~/.ssh/config — generic client defaults. This repo is public, so keep
# hostnames, IPs and usernames out of here: put real hosts in untracked
# ~/.ssh/config.local (link.sh creates a placeholder).
#
# ssh keeps the first value it finds for each option, so the include comes
# first (its settings win) and the Host * defaults come last.

Include config.local

Host *
    # Reuse one connection per host: after the first ssh/scp/git call, later
    # ones skip the handshake. The shared connection lingers 10 minutes after
    # the last session closes; `ssh -O exit <host>` drops it early.
    ControlMaster auto
    ControlPath ~/.ssh/control-%C
    ControlPersist 10m

    # Notice a dead connection within ~3 minutes instead of hanging.
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Add a key to the agent on first use, so its passphrase is asked once
    # per login.
    AddKeysToAgent yes

    # Trust a new host's key on first connect without prompting, but still
    # refuse to connect if a known host's key changes.
    StrictHostKeyChecking accept-new
