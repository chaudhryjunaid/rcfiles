# ripgrep defaults, one flag per line. Symlinked to ~/.config/ripgrep/config
# by link.sh. Only the interactive `rg` alias in ~/.shellrc.sh points
# RIPGREP_CONFIG_PATH here, so scripts and tools that run rg themselves
# (fzf, nvim's :Rg, Claude Code) keep ripgrep's plain defaults.

# Case-insensitive unless the pattern has a capital letter.
--smart-case

# Search dotfiles too (still skipping what .gitignore lists), but not .git.
--hidden
--glob=!.git/
