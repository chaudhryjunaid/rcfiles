# Global gitignore: git reads ~/.config/git/ignore by default (no
# core.excludesFile needed). Symlinked there by link.sh.

# Folder view configuration files
.DS_Store
Desktop.ini

# Thumbnail cache files
._*
Thumbs.db

# vim files
# swap (GitHub's Vim template; these skip .ssh and *.svg)
[._]*.s[a-v][a-z]
!*.svg
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
# session
Session.vim
# temporary
.netrwhist
*~

# Webstorm
.idea

# vscode: personal state, but not the files projects share on purpose
# (GitHub's VisualStudioCode template)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Compiled Python files
*.pyc
__pycache__/

# mise's per-checkout overrides, meant to stay untracked
mise.local.toml
.mise.local.toml

# Files that might appear on external disks
.Spotlight-V100
.Trashes

**/.claude/settings.local.json

**/.claude/.cc-writes/
