# Shared git config, linked to ~/.config/git/config by link.sh. The identity
# (user.name/email) and anything `git config --global` or git tools write go
# in the untracked ~/.gitconfig, which git reads after this file (so it wins).
# link.sh creates it; setup/git-identity.sh fills in the identity.
[user]
  useConfigOnly = true          # No identity set? Refuse to commit, don't guess one
[core]
  editor = nvim
  excludesfile = ~/.gitignore_global
  pager = delta
  untrackedCache = true        # Cache untracked-file scans: much faster `git status`
[init]
  defaultBranch = dev
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  line-numbers = true
  side-by-side = false         # Two columns wrap badly in tmux splits; `delta -s` or DELTA_FEATURES=+side-by-side for one-offs
  hyperlinks = true            # File paths and line numbers are clickable (kitty, Ghostty)
[log]
  abbrevCommit = true
[fetch]
  prune = true
  pruneTags = false             # true would delete local tags that aren't on the remote
  writeCommitGraph = true       # Faster log --graph, merge-base, branch --contains
[pull]
  rebase = true                 # Linear history; pairs with rebase.autoStash below
[push]
  default = current
  autoSetupRemote = true  # Auto-create remote branch on first push
  followTags = true       # Push annotated tags that point at pushed commits
[rebase]
  autoStash = true              # Auto-stash/unstash during rebase
  updateRefs = true             # Update dependent branches
  autoSquash = true             # Honor fixup!/squash! commits in rebase -i
[rerere]
  enabled = true
  autoUpdate = true             # Stage files that rerere resolved
# difftool/mergetool settings
[diff]
  algorithm = histogram         # Cleaner hunks than the default myers
  colorMoved = default          # Highlight moved (not changed) lines
  colorMovedWS = allow-indentation-change  # ...even when re-indented
  tool = cursor
[difftool]
  prompt = false
[mergetool]
  prompt = false
  keepBackup = false
[difftool "vscode"]
  cmd = code --wait --diff $LOCAL $REMOTE
[difftool "cursor"]
  cmd = cursor --wait --diff $LOCAL $REMOTE
[difftool "nvim"]
  cmd = nvim -d $LOCAL $REMOTE
[merge]
  conflictstyle = zdiff3
  tool = cursor
[mergetool "vscode"]
  cmd = code --wait $MERGED
[mergetool "cursor"]
  cmd = cursor --wait $MERGED
[mergetool "nvim"]
  cmd = nvim -d $LOCAL $BASE $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
# alias settings
[alias]
  # diff/merge tool aliases
  diffv = difftool --tool=vscode
  diffc = difftool --tool=cursor
  diffvi = difftool --tool=nvim
  mergev = mergetool --tool=vscode
  mergec = mergetool --tool=cursor
  mergevi = mergetool --tool=nvim
  # Quick status
  s = status --short --branch
  # Branch management
  recent = branch --sort=-committerdate -10
  gone = !git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | awk '$2 == \"[gone]\" {print $1}' | xargs -r git branch -D
  # Stash with message
  save = stash push -m
  # Show files in last commit
  last = show --name-only
  # List available aliases
  aliases = !git config --get-regexp alias | sed -re 's/alias\\.(\\S*)\\s(.*)$/\\1 = \\2/g'
  # Display tree-like log, because default log is a pain…
  lg = log --graph --date=relative --pretty=tformat:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%an %ad)%Creset'
  # Useful when you have to update your last commit
  # with staged files without editing the commit message.
  recommit = commit --amend --no-edit
  # Edit last commit message
  reword = commit --amend
  # Undo last commit but keep changed files in stage
  uncommit = reset --soft HEAD~1
  unstage = restore --staged --   # Unstage files
  # Remove file(s) from Git but not from disk
  untrack = rm --cached --
[commit]
  verbose = true                # Show the diff in the commit message editor
[branch]
  sort = -committerdate         # `git branch` lists most recent first
[tag]
  sort = version:refname        # v1.10 after v1.9
[column]
  ui = auto                     # Columnar `git branch`/`git tag` output
[help]
  autocorrect = prompt          # Offer to run the likely-intended command
