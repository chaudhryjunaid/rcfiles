# Readline config (bash, python, psql, ...). Symlinked to ~/.inputrc by
# link.sh. Brings bash's line editing closer to the zsh setup.

# Keep the distro's key bindings (Home/End, Ctrl-arrows, ...).
$include /etc/inputrc

# Completion: case-insensitive, - and _ interchangeable, every match listed
# on the first Tab, colored like ls, with the typed prefix highlighted.
set completion-ignore-case on
set completion-map-case on
set show-all-if-ambiguous on
set colored-stats on
set colored-completion-prefix on
set mark-symlinked-directories on

# No beep.
set bell-style none

# Up/Down search history for lines starting with what's typed so far (an
# empty line steps through all history), like zsh's up-line-or-beginning-search.
"\e[A": history-search-backward
"\e[B": history-search-forward
"\eOA": history-search-backward
"\eOB": history-search-forward
