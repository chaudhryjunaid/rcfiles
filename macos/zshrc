# Entry point for zsh on macOS. Symlinked to ~/.zshrc by configure.sh.
# Sources the shared ~/.zshrc.common, then adds macOS-specific setup.
# Homebrew's shellenv is set up in ~/.zprofile.
# Don't let installers append here; put machine-specific lines in ~/.zshrc.machine.

set -o vi

[ -f ~/.zshrc.common ] && source ~/.zshrc.common

# Liquidprompt reads ~/.liquidpromptrc itself.
[ -f /opt/homebrew/share/liquidprompt ] && . /opt/homebrew/share/liquidprompt

# Per-machine overrides (untracked); last so they win.
[ -f ~/.zshrc.machine ] && source ~/.zshrc.machine

# typeset -U only dedupes array assignments; apply it to PATH=... edits above.
path=($path)
